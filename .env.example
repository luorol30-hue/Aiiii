# Shared
ENVIRONMENT=development
API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Database and infrastructure
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/farm_ai
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333

# Auth
JWT_SECRET=replace-with-a-strong-secret
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=10080
GOOGLE_CLIENT_ID=

# Twilio Verify / SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
TWILIO_FROM_NUMBER=

# Weather provider: openweather, tomorrow, or weatherapi
WEATHER_PROVIDER=openweather
OPENWEATHER_API_KEY=
TOMORROW_API_KEY=
WEATHERAPI_KEY=

# Satellite data
SENTINELHUB_CLIENT_ID=
SENTINELHUB_CLIENT_SECRET=

# S3-compatible storage. For local MinIO, use endpoint http://localhost:9000.
S3_BUCKET=farm-ai
S3_REGION=us-east-1
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_PUBLIC_BASE_URL=http://localhost:9000/farm-ai

# AI model artifacts
DISEASE_MODEL_PATH=
DISEASE_MODEL_TYPE=yolo
YIELD_MODEL_PATH=

# Notifications
FIREBASE_CREDENTIALS_JSON=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# CORS
CORS_ORIGINS=http://localhost:3000

# Frontend maps
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_MAPBOX_TOKEN=
